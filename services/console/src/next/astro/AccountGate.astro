---
import { VERSION_KEY } from "../memory";

interface Props {
	/** The same page in the new console. */
	next: string;
}

const { next } = Astro.props;

// A reader with a version 1 project moves to the new console's page before
// the classic page loads anything, with the query the page reads.
---

<script is:inline define:vars={{ next, VERSION_KEY }}>
	try {
		var versions = JSON.parse(localStorage.getItem(VERSION_KEY) || "{}");
		if (Object.values(versions).indexOf(1) !== -1) {
			location.replace(next + location.search);
		}
	} catch (_) {}
</script>
