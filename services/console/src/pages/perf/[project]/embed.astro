---
// The browser reads the project and its plot, so the server reads nothing.
export const prerender = false;

import { BENCHER_API_URL } from "astro:env/server";

import Embed from "../../../next/embed/Embed";
import { drawable } from "../../../next/explore/request";
import Head from "../../../next/Head.astro";
import { embedPreloads } from "../../../next/preloads";
import { publicPlotPath } from "../../../next/public/query";
import { BENCHER_SITE_URL } from "../../../util/ext";
import { decodeQuery } from "../../../next/query/query";
import "../../../next/embed/page.css";

const slug = Astro.params.project ?? "";
const query = decodeQuery(Astro.url.search);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{slug} | Bencher</title>
		<link rel="canonical" href={`${BENCHER_SITE_URL}${publicPlotPath(slug)}`} />
		<link rel="icon" href="/favicon.svg" sizes="any" type="image/svg+xml" />
		<Head />
		{embedPreloads(drawable(query) ? ["plot/Plot"] : []).map((href) => <link rel="modulepreload" href={href} />)}
	</head>
	<body>
		<div id="embed" data-api-url={BENCHER_API_URL} data-slug={slug}>
			<Embed slug={slug} query={query} view="plot" />
		</div>
		<script>
			import "../../../next/embed/main";
		</script>
	</body>
</html>
