---
import { READER_KEY } from "../reader";

// Runs before the first paint and before any module loads: a reader who is
// not signed in.
---

<script is:inline define:vars={{ READER_KEY }}>
	try {
		if (!localStorage.getItem(READER_KEY)) {
			location.replace(
				"/auth/login?" +
					new URLSearchParams({
						back: btoa(location.pathname + location.search + location.hash),
					}),
			);
		}
	} catch (_) {}
</script>
