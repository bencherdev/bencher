        "execution": "local",
        "script": "import http from 'k6/http';\nimport { check, group } from 'k6';\nimport { Counter, Trend } from 'k6/metrics';\n\nconst orderTime = new Trend('order_time', true);\nconst ordersPlaced = new Counter('orders_placed');\n\nexport const options = {\n  scenarios: {\n    browse: {\n      executor: 'constant-arrival-rate',\n      rate: 200,\n      timeUnit: '1s',\n      duration: '5s',\n      preAllocatedVUs: 20,\n      exec: 'browse',\n    },\n    checkout: {\n      executor: 'constant-vus',\n      vus: 5,\n      duration: '5s',\n      exec: 'checkout',\n      tags: { flow: 'checkout' },\n    },\n  },\n  thresholds: {\n    http_req_duration: ['p(95)<500'],\n    'http_req_duration{scenario:browse}': ['p(99)<100'],\n    'http_req_duration{group:::checkout::pay}': ['avg<200'],\n    'http_req_failed{name:fast}': ['rate<0.01'],\n    checks: ['rate>0.9'],\n    order_time: ['p(95)<300'],\n  },\n};\n\nexport function browse() {\n  group('home', () => {\n    const res = http.get('http://localhost:8080/fast', { tags: { name: 'fast' } });\n    check(res, { 'home is 200': (r) => r.status === 200 });\n  });\n}\n\nexport function checkout() {\n  group('checkout', () => {\n    group('cart', () => {\n      const res = http.get('http://localhost:8080/slow');\n      check(res, { 'cart is 200': (r) => r.status === 200 });\n    });\n    group('pay', () => {\n      const res = http.post('http://localhost:8080/post', 'item=1');\n      check(res, { 'pay is 201': (r) => r.status === 201 });\n      orderTime.add(res.timings.duration);\n      ordersPlaced.add(1);\n    });\n  });\n  const err = http.get('http://localhost:8080/error');\n  check(err, { 'error is 500': (r) => r.status === 500 });\n}\n"
    },
