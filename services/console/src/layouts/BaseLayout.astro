---
import { SEO } from "astro-seo";
import "../styles/styles.scss";
import Navbar from "../components/navbar/Navbar.astro";
import Footer from "../components/site/Footer.astro";
import GoogleAnalytics from "../components/site/GoogleAnalytics.astro";
import { BENCHER_TITLE, BENCHER_DESCRIPTION } from "../util/resource";
import { BENCHER_OG_IMAGE, BENCHER_SITE_URL } from "../util/ext";
import { defaultLang } from "../i18n/ui.ts";
import {
	type Author,
	TWITTER_BENCHER,
	twitter,
} from "../components/docs/author";
// import { ClientRouter } from "astro:transitions";

interface Props {
	title: string;
	titleFmt?: undefined | ((title: string) => string);
	description: string;
	published?: undefined | string;
	modified?: undefined | string;
	lang?: undefined | string;
	author?: undefined | Author;
	canonical?: undefined | string;
	theme?: undefined | string;
	analytics?: undefined | boolean;
	/** The page's address in link previews, instead of the address it was requested at. */
	url?: undefined | string;
}

const {
	title,
	titleFmt,
	description,
	published,
	modified,
	lang,
	author,
	canonical,
	theme,
	analytics = true,
	url,
} = Astro.props;

const BENCHER_OG_IMAGE_ALT = "🐰 Bencher";

const image = {
	url: BENCHER_OG_IMAGE,
	type: "image/png",
	width: 1200,
	height: 630,
	alt: BENCHER_OG_IMAGE_ALT,
};

const article = () => {
	const article: {
		publishedTime?: string;
		modifiedTime?: string;
		expirationTime?: string;
		authors?: string[];
		section?: string;
		tags?: string[];
	} = {};
	if (published) {
		article.publishedTime = published;
	}
	if (modified) {
		article.modifiedTime = modified;
	}
	if (author) {
		article.authors = [author];
		article.section = "Technology";
		article.tags = [
			"Technology",
			"Software",
			"Programming",
			"Benchmarks",
			"Benchmarking",
			"Performance",
			"Continuous Integration",
			"Continuous Benchmarking",
		];
	}
	return article;
};
---

<!doctype html>
<html lang={lang ?? defaultLang} data-pagefind-filter="lang[lang]" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <slot name="head" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.png" sizes="48x48" type="image/png" />
    <link rel="icon" href="/favicon.svg" sizes="any" type="image/svg+xml" />
    <link
      rel="apple-touch-icon"
      href="https://s3.amazonaws.com/public.bencher.dev/img/apple-touch-icon.png"
    />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={title}
      titleTemplate={title === BENCHER_TITLE ? "%s" : `%s | ${BENCHER_TITLE}`}
      titleDefault={BENCHER_TITLE}
      description={description ?? BENCHER_DESCRIPTION}
      canonical={canonical ?? `${BENCHER_SITE_URL}${Astro.url.pathname}`}
      openGraph={{
        basic: {
          title: titleFmt ? titleFmt(title) : title,
          type: "website",
          image: BENCHER_OG_IMAGE,
          url,
        },
        optional: {
          siteName: "🐰 Bencher",
          description: description ?? BENCHER_DESCRIPTION,
        },
        image,
        article: article(),
      }}
      twitter={{
        card: "summary_large_image",
        site: TWITTER_BENCHER,
        creator: author ? twitter(author) : TWITTER_BENCHER,
        title: titleFmt ? titleFmt(title) : title,
        description: description ?? BENCHER_DESCRIPTION,
        image: BENCHER_OG_IMAGE,
        imageAlt: BENCHER_OG_IMAGE_ALT,
      }}
    />
    <!-- https://devicon.dev/ -->
    <link
      rel="preload"
      href="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.16.0/devicon.min.css"
      as="style"
      onload="this.onload = null; this.rel = 'stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.16.0/devicon.min.css"
      />
    </noscript>
    <!-- font awesome -->
    <script defer src="https://use.fontawesome.com/releases/v5.15.4/js/all.js"
    ></script>
    {analytics && <GoogleAnalytics />}
    <!-- https://docs.astro.build/en/guides/view-transitions/ -->
    <!-- <ClientRouter /> -->
  </head>
  <body>
    <slot name="navbar">
      <Navbar />
    </slot>
    <main>
      <slot />
    </main>
    <slot name="footer">
      <Footer />
    </slot>
  </body>
</html>
