{
	"project": ["**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,astro,mdx,sass,scss}!"],
	"ignoreDependencies": ["@sentry/cloudflare", "wrangler"],
	"astro": {
		"entry": [
			"astro.config.{js,cjs,mjs,ts}",
			"src/content.config.ts",
			"src/pages/**/*.{astro,mdx,js,ts}",
			"src/content/**/*.mdx",
			"src/chunks/**/*.mdx",
			"src/middleware.{js,ts}",
			"src/actions/index.{js,ts}"
		]
	}
}
