---
import { VERSION_KEY } from "../memory";
import { nextHref, projectPath } from "../paths";
import { USER_KEY } from "../reader";

interface Props {
	slug: string | undefined;
	/** Where the page goes instead of its place under /next/, query and all. */
	next?: string | undefined;
	/** Where a reader who is not signed in goes instead, as the classic page would send them. */
	signedOut?: string | undefined;
}

const { slug, signedOut } = Astro.props;
const next =
	Astro.props.next ?? nextHref({ pathname: Astro.url.pathname, hash: "" });
// The perf page's query is Explore's, read as the page loads.
const search = slug !== undefined && next === projectPath(slug, "explore");

// A classic project page whose project the reader has seen on version 1 moves
// to the new console before the page loads anything.
---

{
	slug && next && !signedOut && (
		<script is:inline define:vars={{ slug, next, search, VERSION_KEY }}>
			try {
				var versions = JSON.parse(localStorage.getItem(VERSION_KEY) || "{}");
				if (versions && versions[slug] === 1) {
					location.replace(next + (search ? location.search : "") + location.hash);
				}
			} catch (_) {}
		</script>
	)
}
{
	slug && next && signedOut && (
		<script
			is:inline
			define:vars={{ slug, next, signedOut, VERSION_KEY, USER_KEY }}
		>
			try {
				var versions = JSON.parse(localStorage.getItem(VERSION_KEY) || "{}");
				if (versions && versions[slug] === 1) {
					location.replace(localStorage.getItem(USER_KEY) ? next : signedOut);
				}
			} catch (_) {}
		</script>
	)
}
