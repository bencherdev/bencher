---
// The server reads the project without a sign in, as the classic perf page
// does, so a version 0 project goes back before anything loads and the
// document names the project for whoever shares or crawls it.
export const prerender = false;

import { BENCHER_API_URL, INTERNAL_API_URL } from "astro:env/server";

import { fetchSSR } from "../../../components/perf/util";
import Head from "../../../next/Head.astro";
import { drawable } from "../../../next/explore/request";
import { perfPreloads } from "../../../next/preloads";
import Public from "../../../next/public/Public";
import { decodeQuery } from "../../../next/query/query";
import { USER_KEY, signInHref } from "../../../next/reader";
import type { JsonProject } from "../../../types/bencher";
import "../../../next/public/page.css";

const slug = Astro.params.project ?? "";
let project: JsonProject | undefined;
// Whether the project answered without a sign in: public, private (or no such
// project), or unknown when the API did not answer.
let found: "public" | "private" | "unknown" = "unknown";
try {
	const response = await fetchSSR(
		`${INTERNAL_API_URL ?? BENCHER_API_URL}/v0/projects/${encodeURIComponent(slug)}`,
	);
	if (response.ok) {
		project = await response.json();
		found = "public";
	} else if (response.status < 500) {
		found = "private";
	}
} catch {}
if (project && project.bmf_version !== 1) {
	return Astro.redirect(`/perf/${slug}${Astro.url.search}`);
}
const name = project?.name ?? slug;
const query = decodeQuery(Astro.url.search);
const plot = found === "public" && drawable(query);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{name} | Bencher</title>
		<meta
			name="description"
			content={`${name} performance over time, continuously benchmarked with Bencher`}
		/>
		<link rel="icon" href="/favicon.svg" sizes="any" type="image/svg+xml" />
		<script is:inline define:vars={{ USER_KEY }}>
			try {
				var reader = JSON.parse(localStorage.getItem(USER_KEY) || "null");
				if (reader && reader.token && Date.parse(reader.expiration) > Date.now()) {
					document.documentElement.setAttribute("data-reader", "");
				}
			} catch (_) {}
		</script>
		<Head />
		{perfPreloads(plot ? ["plot/Plot"] : []).map((href) => <link rel="modulepreload" href={href} />)}
	</head>
	<body>
		<div
			id="public"
			class="console"
			data-api-url={BENCHER_API_URL}
			data-slug={slug}
			data-name={name}
			data-found={found}
		>
			<Public
				slug={slug}
				name={name}
				query={query}
				signIn={signInHref(`${Astro.url.pathname}${Astro.url.search}`)}
				view={found === "private" ? "checking" : "plot"}
				embeddable={found === "public"}
			/>
		</div>
		<script>
			import "../../../next/public/main";
		</script>
	</body>
</html>
