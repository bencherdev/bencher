    "script": "import http from 'k6/http';\nimport { check, group } from 'k6';\nimport { Counter, Gauge, Rate, Trend } from 'k6/metrics';\n\nconst orderTime = new Trend('order_time', true);\nconst queueDepth = new Trend('queue_depth');\nconst ordersPlaced = new Counter('orders_placed');\nconst cartSize = new Gauge('cart_size');\nconst paid = new Rate('paid');\n\nexport const options = {\n  scenarios: {\n    browse: {\n      executor: 'constant-arrival-rate',\n      rate: 100,\n      timeUnit: '1s',\n      duration: '3s',\n      preAllocatedVUs: 2,\n      maxVUs: 2,\n      exec: 'browse',\n    },\n    checkout: {\n      executor: 'constant-vus',\n      vus: 2,\n      duration: '3s',\n      exec: 'checkout',\n      tags: { flow: 'checkout' },\n    },\n  },\n  summaryTimeUnit: 's',\n  summaryTrendStats: ['avg', 'min', 'med', 'max', 'p(90)', 'p(95)', 'p(99)', 'p(99.9)', 'count'],\n  thresholds: {\n    http_req_duration: ['p(95)<500'],\n    'http_req_duration{scenario:browse}': ['p(99)<100'],\n    'http_req_duration{group:::checkout::pay}': [],\n    'http_req_duration{status:500}': [],\n    'http_reqs{status:200}': [],\n    'http_reqs{status:599}': [],\n    'http_reqs{expected_response:false}': [],\n    'http_req_failed{name:fast}': [],\n    'checks{check:home is 200}': [],\n    'data_received{scenario:browse}': [],\n    'order_time{flow:checkout}': [],\n    checks: ['rate>0.9'],\n  },\n};\n\nexport function browse() {\n  group('home', () => {\n    const res = http.get('http://localhost:8080/slow', { tags: { name: 'fast' } });\n    check(res, { 'home is 200': (r) => r.status === 200 });\n  });\n}\n\nexport function checkout() {\n  group('checkout', () => {\n    group('cart', () => {\n      const res = http.get('http://localhost:8080/fast');\n      check(res, { 'cart is 200': (r) => r.status === 200 });\n      cartSize.add(3);\n      queueDepth.add(5);\n    });\n    group('pay', () => {\n      const res = http.post('http://localhost:8080/post', 'item=1');\n      check(res, { 'pay is 201': (r) => r.status === 201 });\n      orderTime.add(res.timings.duration);\n      ordersPlaced.add(1);\n      paid.add(res.status === 201);\n    });\n  });\n  const err = http.get('http://localhost:8080/error');\n  check(err, { 'error is 500': (r) => r.status === 500 });\n  http.get('http://localhost:8080/teapot');\n}\n\nexport function handleSummary(data) {\n  return { stdout: JSON.stringify(data, null, 2) };\n}\n"
