---
import { SHELL_KEY } from "../memory";
import { USER_KEY } from "../reader";

interface Props {
	slug: string;
}

const { slug } = Astro.props;

// Runs right after the shell's markup, before the first paint: fills in what
// this reader last saw of the project, so the app's render over it moves
// nothing, and brings the current tab into view on a narrow screen.
---

<script is:inline define:vars={{ slug, SHELL_KEY, USER_KEY }}>
	try {
		var user = JSON.parse(localStorage.getItem(USER_KEY) || "null");
		var record = JSON.parse(localStorage.getItem(SHELL_KEY) || "null");
		var seen =
			user &&
			user.user &&
			record &&
			record.reader === user.user.uuid &&
			record.projects &&
			record.projects[slug];
		if (seen) {
			var hole = document.querySelector('[data-shell="org"]');
			var org = document.createElement("span");
			var crumb = hole.closest("button");
			org.setAttribute("data-shell", "org");
			org.textContent = seen.organization;
			crumb.removeAttribute("aria-busy");
			crumb.setAttribute("aria-label", seen.organization + " / " + seen.name + ", switch project");
			hole.replaceWith(org);
			document.querySelector('[data-shell="project"]').textContent = seen.name;
			if (seen.alerts > 0) {
				var tab = document.querySelector('[data-shell="alerts"]');
				var bell = document.querySelector('[data-shell="bell"]');
				var badge = document.createElement("span");
				var count = seen.alerts > 99 ? "99+" : seen.alerts;
				tab.setAttribute("aria-label", "Alerts " + count + " active");
				bell.setAttribute("aria-label", count + " active alert" + (seen.alerts > 1 ? "s" : ""));
				badge.className = "badge";
				badge.setAttribute("aria-hidden", "true");
				badge.textContent = count;
				tab.append(" ", badge);
				bell.append(" ", badge.cloneNode(true));
			}
		}
		var tabs = document.querySelector(".tabs");
		var current = tabs.querySelector('[aria-current="page"]');
		if (current && tabs.scrollWidth > tabs.clientWidth) {
			var row = tabs.getBoundingClientRect();
			var tab = current.getBoundingClientRect();
			tabs.scrollLeft = Math.max(
				0,
				tab.left - row.left + tabs.scrollLeft - (tabs.clientWidth - tab.width) / 2,
			);
		}
	} catch (_) {}
</script>
