{
	// Cloudflare Workers configuration for the console.
	// The Astro adapter resolves this file at build time and writes the deployable
	// config to `dist/server/wrangler.json`, so the environment is chosen by the
	// build, not by the deploy.
	// The top level builds with `npm run cloudflare` and deploys with `npx wrangler deploy`.
	// The `dev` environment builds with `CLOUDFLARE_ENV=dev npm run cloudflare`
	// and deploys with `npx wrangler deploy --env dev`.
	// https://developers.cloudflare.com/workers/wrangler/configuration/
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "console",
	// The Astro Cloudflare adapter provides the Worker entrypoint.
	// https://docs.astro.build/en/guides/integrations-guide/cloudflare/
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-08-11",
	// Node.js APIs are used by the server bundle.
	// https://developers.cloudflare.com/workers/runtime-apis/nodejs/
	"compatibility_flags": ["nodejs_compat"],
	// A custom domain is the only front door for any environment that has one,
	// so neither the `workers.dev` subdomain nor preview URLs are served.
	// https://developers.cloudflare.com/workers/configuration/previews/
	"workers_dev": false,
	"preview_urls": false,
	// Wrangler creates the DNS record for a custom domain when it deploys.
	// https://developers.cloudflare.com/workers/configuration/routing/custom-domains/
	"routes": [
		{
			"pattern": "bencher.dev",
			"custom_domain": true
		}
	],
	// The adapter points this at the client build output.
	// https://developers.cloudflare.com/workers/static-assets/
	"assets": {
		"binding": "ASSETS",
		// Serve the prerendered pages with a trailing slash, matching their canonical URLs.
		// https://developers.cloudflare.com/workers/static-assets/routing/advanced/html-handling/
		"html_handling": "force-trailing-slash"
	},
	// https://developers.cloudflare.com/workers/observability/logs/workers-logs/
	"observability": {
		"enabled": true
	},
	// Every key above is inheritable, so each environment only sets what differs.
	// Environment variables are not inheritable and must be set for each environment.
	// https://developers.cloudflare.com/workers/wrangler/environments/
	// The OAuth settings are feature flags, not credentials.
	"vars": {
		"BENCHER_API_URL": "https://api.bencher.dev",
		"OAUTH_GITHUB": "true",
		"OAUTH_GOOGLE": "true"
	},
	"env": {
		"dev": {
			"name": "dev-console",
			"workers_dev": false,
			"preview_urls": false,
			// Wrangler creates the DNS record for a custom domain when it deploys.
			// https://developers.cloudflare.com/workers/configuration/routing/custom-domains/
			"routes": [
				{
					"pattern": "dev.bencher.dev",
					"custom_domain": true
				}
			],
			// The OAuth settings are feature flags, not credentials.
			"vars": {
				"BENCHER_API_URL": "https://dev.api.bencher.dev",
				"OAUTH_GITHUB": "true",
				"OAUTH_GOOGLE": "true"
			}
		}
	}
}
