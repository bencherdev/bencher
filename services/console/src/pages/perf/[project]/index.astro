---
// The browser reads the project and its plot, so the server reads nothing.
export const prerender = false;

import { BENCHER_API_URL } from "astro:env/server";

import Head from "../../../next/Head.astro";
import { drawable } from "../../../next/explore/request";
import { perfPreloads } from "../../../next/preloads";
import Public from "../../../next/public/Public";
import { publicPlotPath } from "../../../next/public/query";
import { decodeQuery } from "../../../next/query/query";
import { USER_KEY, signInHref } from "../../../next/reader";
import { BENCHER_OG_IMAGE, BENCHER_SITE_URL } from "../../../util/ext";
import "../../../next/public/page.css";

const slug = Astro.params.project ?? "";
const query = decodeQuery(Astro.url.search);
const title = `${slug} | Bencher`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta
			name="description"
			content={`${slug} performance over time, continuously benchmarked with Bencher`}
		/>
		<meta property="og:title" content={title} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={`${BENCHER_SITE_URL}${publicPlotPath(slug)}`} />
		<meta property="og:image" content={BENCHER_OG_IMAGE} />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="icon" href="/favicon.svg" sizes="any" type="image/svg+xml" />
		<script is:inline define:vars={{ USER_KEY }}>
			try {
				var reader = JSON.parse(localStorage.getItem(USER_KEY) || "null");
				if (reader && reader.token && Date.parse(reader.expiration) > Date.now()) {
					document.documentElement.setAttribute("data-reader", "");
				}
			} catch (_) {}
		</script>
		<Head />
		{perfPreloads(drawable(query) ? ["plot/Plot"] : []).map((href) => <link rel="modulepreload" href={href} />)}
	</head>
	<body>
		<div id="public" class="console" data-api-url={BENCHER_API_URL} data-slug={slug}>
			<Public
				slug={slug}
				name={slug}
				query={query}
				signIn={signInHref(`${Astro.url.pathname}${Astro.url.search}`)}
				view="plot"
			/>
		</div>
		<script>
			import "../../../next/public/main";
		</script>
	</body>
</html>
