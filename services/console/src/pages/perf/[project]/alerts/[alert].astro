---
export const prerender = false;

import { BENCHER_API_URL, INTERNAL_API_URL } from "astro:env/server";

import PerfResource from "../../../../layouts/perf/PerfResource.astro";
import alertsPubConfig from "../../../../config/project/alerts_pub";
import { fetchSSR } from "../../../../components/perf/util";
import ClassicGate from "../../../../next/astro/ClassicGate.astro";
import { alertLine } from "../../../../next/explore/start";
import { alertPath } from "../../../../next/paths";
import { publicPlotPath } from "../../../../next/public/query";
import { exploreSearch } from "../../../../next/query/selection";
import { USER_KEY } from "../../../../next/reader";
import {
	AlertStatus,
	type JsonAlert,
	type JsonProject,
} from "../../../../types/bencher";

const { project: slug = "", alert: uuid = "" } = Astro.params;
const api = INTERNAL_API_URL ?? BENCHER_API_URL;
// The window an alert's page draws: the 4 weeks ending at its report.
const WINDOW_SECONDS = 28 * 86_400;

// A version 1 project's alert has a page in the new console for whoever is
// signed in, and the public plot of its line at its report for anyone else.
let next: { signedIn: string; signedOut: string } | undefined;
let read = false;
// Read beside the project, so the classic page that draws it reads nothing more.
let resource: object | undefined;
try {
	const [response, answer] = await Promise.all([
		fetchSSR(`${api}/v0/projects/${encodeURIComponent(slug)}`),
		fetchSSR(
			`${api}/v0/projects/${encodeURIComponent(slug)}/alerts/${encodeURIComponent(uuid)}`,
		).then(
			(answer) => answer.json(),
			() => undefined,
		),
	]);
	resource = answer;
	read = response.ok;
	const project: JsonProject | undefined = read
		? await response.json()
		: undefined;
	if (project?.bmf_version === 1 && answer?.uuid) {
		const alert: JsonAlert = answer;
		next = {
			signedIn: alertPath(slug, alert.uuid),
			signedOut: `${publicPlotPath(slug)}${exploreSearch([alertLine(alert)], {
				window: { seconds: WINDOW_SECONDS, end: Date.parse(alert.created) },
				report: alert.report,
			})}`,
		};
	}
} catch {}
---

{
	next ? (
		<html lang="en">
			<head>
				<meta charset="utf-8" />
				<meta name="robots" content="noindex" />
				<title>Alert | Bencher</title>
				<script is:inline define:vars={{ USER_KEY, ...next }}>
					try {
						var reader = JSON.parse(localStorage.getItem(USER_KEY) || "null");
						location.replace(
							reader && reader.token && Date.parse(reader.expiration) > Date.now()
								? signedIn
								: signedOut,
						);
					} catch (_) {
						location.replace(signedOut);
					}
				</script>
			</head>
			<body>
				<a href={next.signedOut}>Open the plot</a>
			</body>
		</html>
	) : (
		<PerfResource
			title={(json) => json ? `${json?.benchmark?.name} Alert (${
				json?.status === AlertStatus.Active ? "🔔" : "🔕"
			})` : "Public Alert"}
			titleFmt={(title) => `🚨 ${title}`}
			description={(_json) => "View a continuous benchmarking alert on Bencher"}
			created={(json) => json?.created ?? ""}
			modified={(json) => json?.modified ?? ""}
			config={alertsPubConfig}
			json={resource}
		>
			{!read && <ClassicGate slot="head" slug={slug} next={alertPath(slug, uuid)} />}
		</PerfResource>
	)
}
