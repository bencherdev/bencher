{
	"$id": "https://bencher.dev/bmf.json",
	"$schema": "http://json-schema.org/draft-07/schema",
	"type": "object",
	"additionalProperties": {
		"type": "array",
		"items": {
			"type": "object",
			"properties": {
				"parameters": {
					"type": "object",
					"additionalProperties": {
						"type": ["string", "number", "boolean"]
					}
				},
				"measures": {
					"type": "object",
					"additionalProperties": {
						"type": "object",
						"additionalProperties": {
							"type": "number"
						}
					}
				}
			},
			"required": ["measures"]
		}
	}
}
