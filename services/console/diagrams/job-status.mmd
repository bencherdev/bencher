%%{init: {'theme': 'base'}}%%
stateDiagram-v2
    [*] --> pending
    pending --> claimed: runner claims
    pending --> canceled: user cancels
    claimed --> running: running
    claimed --> failed: failed
    claimed --> unknown: lost contact
    claimed --> canceled: user cancels
    running --> completed: completed
    running --> failed: failed
    running --> unknown: lost contact
    running --> canceled: cancel / hard timeout
    unknown --> completed: completed
    unknown --> failed: failed
    unknown --> canceled: cancel / hard timeout
    completed --> processed: results parsed
    completed --> failed: processing failed
    completed --> unknown: results lost
    processed --> [*]
    failed --> [*]
    canceled --> [*]
