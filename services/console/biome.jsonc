{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		// Biome 2 reads far more file types than Biome 1 did. Generated output,
		// static assets, and standalone SVGs are not ours to lint or format.
		"includes": [
			"**",
			"!**/.astro/**",
			"!**/.wrangler/**",
			"!**/dist/**",
			"!**/public/**",
			"!**/diagrams/output/**",
			"!**/*.svg"
		]
	},
	"formatter": {
		// `src/types/bencher.ts` is generated by typeshare.
		"includes": ["**", "!src/types/bencher.ts"]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "error"
			},
			"a11y": {
				// New to `recommended` in Biome 2. The Bulma modal backdrops and tab
				// headers it flags need real roles and key handlers, which is its own
				// change rather than part of a dependency upgrade.
				"noStaticElementInteractions": "off"
			}
		}
	},
	"overrides": [
		{
			// Biome only parses the frontmatter of an `.astro` file, so anything
			// imported or bound for use in the template below looks unused.
			"includes": ["**/*.astro"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					}
				}
			}
		}
	],
	"assist": {
		// Import organization is not enforced, and enabling it would rewrite
		// imports across the whole tree.
		"enabled": false
	}
}
