{
	"$id": "https://bencher.dev/v1/bmf.json",
	"$schema": "http://json-schema.org/draft-07/schema",
	"type": "object",
	"patternProperties": {
		".+": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"parameters": {
						"type": "object",
						"maxProperties": 8,
						"patternProperties": {
							".+": {
								"type": ["string", "number", "boolean"]
							}
						}
					},
					"measures": {
						"type": "object",
						"patternProperties": {
							".+": {
								"type": "object",
								"patternProperties": {
									".+": {
										"type": "number"
									}
								}
							}
						}
					}
				},
				"required": ["measures"]
			}
		}
	}
}
