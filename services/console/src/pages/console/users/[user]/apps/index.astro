---
export const prerender = false;

import { BENCHER_API_URL } from "astro:env/server";

import UserLayout from "../../../../../layouts/console/UserLayout.astro";
import ConnectedApps from "../../../../../components/console/apps/ConnectedApps";
import FallbackTablePanel from "../../../../../components/console/table/FallbackTablePanel.astro";

const params = Astro.params;
const title = "Connected Apps";
---

<UserLayout apiUrl={BENCHER_API_URL} params={params} title={title}>
  <ConnectedApps client:only="solid-js" apiUrl={BENCHER_API_URL} params={params}>
    <FallbackTablePanel slot="fallback" />
  </ConnectedApps>
</UserLayout>
