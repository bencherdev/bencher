---
import type { Params } from "astro";
import ConsoleLayout from "./ConsoleLayout.astro";
import UserMenu from "../../components/console/menu/UserMenu";
import UserFallbackMenu from "../../components/console/menu/UserFallbackMenu";

interface Props {
	params: Params;
	title: string;
}

const { params, title } = Astro.props;
---

<ConsoleLayout params={params} title={title}>
  <slot name="head" slot="head" />
  <UserMenu client:only="solid-js" slot="menu">
	<UserFallbackMenu slot="fallback" />
  </UserMenu>
  <slot />
</ConsoleLayout>
